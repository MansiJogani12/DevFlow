generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Person {
  id        String  @id
  name      String
  imageURL  String?
  email     String?
  workingHours String?
  team      String?
  role      String?
  location  String?
  phone     String?
  bio       String?
  Issues    Issue[] @relation("Assignee")
}

model Project {
  id          String  @id
  name        String
  description String?
  ownerId     String?
  status      String?
  startDate   DateTime?
  endDate     DateTime?
  imageURL    String?
  color       String?
  team        String?
  Issues      Issue[]
}

model Issue {
  id         String   @id
  title      String
  description String?
  status     String?
  priority   String?
  storyPoints Int?
  assigneeId String?
  projectId  String?
  createdAt  DateTime?
  updatedAt  DateTime?
  Assignee   Person?  @relation("Assignee", fields: [assigneeId], references: [id])
  Project    Project? @relation(fields: [projectId], references: [id])
}
